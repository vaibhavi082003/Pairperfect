  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #fff;
    border-radius: 16px;
    border: 1px solid var(--golden-border);
  }
  .empty-icon { font-size: 40px; margin-bottom: 10px; display: inline-block; }

  /* 6. GEN-Z FEATURES SECTION */
  .genz-features-section {
    background: #ffffff;
    border-top: 1px solid var(--golden-border);
    border-bottom: 1px solid var(--golden-border);
    padding: 60px 20px;
  }
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .center-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 40px;
  }
  .center-header h2 {
    font-size: 32px;
    font-weight: 900;
    color: var(--maroon);
    margin: 8px 0;
  }
  .center-header p {
    color: #666;
    font-size: 15px;
    margin: 0;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  .feature-card {
    background: var(--golden-soft);
    border: 1.5px solid var(--golden-border);
    padding: 26px 22px;
    border-radius: 16px;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .feature-card:hover {
    transform: translateY(-5px);
    border-color: var(--golden);
  }
  .feature-icon-box {
    font-size: 32px;
    margin-bottom: 14px;
  }
  .feature-card h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 800;
    color: var(--maroon);
  }
  .feature-card p {
    margin: 0;
    font-size: 13.5px;
    color: #555;
    line-height: 1.5;
  }

  /* 7. HOW IT WORKS SECTION */
  .how-it-works-section {
    padding: 60px 20px;
    background: #fffcf7;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 26px;
  }
  .step-card {
    background: #ffffff;
    border: 2px dashed var(--golden-border);
    padding: 30px 24px;
    border-radius: 16px;
    position: relative;
  }
  .step-number {
    font-size: 36px;
    font-weight: 900;
    color: var(--golden);
    margin-bottom: 8px;
  }
  .step-card h4 {
    margin: 0 0 8px;
    font-size: 18px;
    color: var(--maroon);
  }
  .step-card p {
    margin: 0;
    font-size: 13.5px;
    color: #666;
    line-height: 1.5;
  }

  /* 8. TESTIMONIALS SECTION */
  .testimonials-section {
    padding: 60px 20px;
    background: #ffffff;
    border-top: 1px solid var(--golden-border);
  }
  .stories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .story-card {
    background: #fffdf9;
    border: 1.5px solid var(--golden-border);
    padding: 24px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .highlight-story {
    border-color: var(--golden);
    box-shadow: 0 10px 25px rgba(197, 155, 39, 0.15);
    background: var(--golden-soft);
  }
  .story-stars { font-size: 14px; margin-bottom: 12px; }
  .story-quote {
    font-size: 13.5px;
    line-height: 1.6;
    color: #333;
    font-style: italic;
    margin: 0 0 16px;
  }
  .story-author strong {
    display: block;
    font-size: 15px;
    color: var(--maroon);
  }
  .story-author span {
    font-size: 12px;
    color: #777;
  }

  /* 9. MODALS */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(30, 5, 12, 0.65);
    backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 300;
    padding: 20px;
  }
  .login-modal-box {
    background: #ffffff;
    border: 2px solid var(--golden-border);
    border-radius: 20px;
    width: 100%;
    max-width: 400px;
    padding: 30px 24px;
    position: relative;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
  }
  .close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #f7ede2;
    border: none;
    color: var(--maroon);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 14px;
    cursor: pointer;
    font-weight: bold;
  }
  .modal-title { text-align: center; margin-bottom: 20px; }
  .modal-icon { font-size: 26px; }
  .modal-title h2 {
    margin: 4px 0 4px;
    font-size: 22px;
    color: var(--maroon);
    font-weight: 800;
  }
  .modal-title p { margin: 0; color: #666; font-size: 13px; }
  .modal-error {
    background: #fde8e8;
    border: 1px solid #f8b4b4;
    color: #9b1c1c;
    padding: 10px;
    border-radius: 8px;
    font-size: 13px;
    margin-bottom: 14px;
    text-align: center;
  }
  .modal-form { display: flex; flex-direction: column; gap: 14px; }
  .input-box { display: flex; flex-direction: column; gap: 5px; text-align: left; }
  .input-box label { font-size: 12px; color: #444; font-weight: 700; }
  .input-box input {
    background: #fffdfa;
    border: 1.5px solid #d9cdb8;
    border-radius: 8px;
    padding: 11px 12px;
    color: #222;
    font-size: 14px;
    outline: none;
  }
  .input-box input:focus { border-color: var(--maroon); }
  .btn-modal-submit {
    background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-light) 100%);
    color: white;
    border: none;
    padding: 12px;
    border-radius: 8px;
    font-weight: 800;
    cursor: pointer;
    margin-top: 6px;
    font-size: 14px;
  }
  .modal-bottom { text-align: center; font-size: 13px; color: #666; margin: 16px 0 0; }
  .modal-bottom a { color: var(--maroon); text-decoration: underline; font-weight: 700; }

  /* Bio-Data Modal */
  .bio-modal-box {
    background: #ffffff;
    border: 2px solid var(--golden-border);
    border-radius: 18px;
    width: 100%;
    max-width: 500px;
    padding: 24px;
    position: relative;
    box-shadow: 0 20px 45px rgba(0,0,0,0.25);
  }
  .bio-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid #f0e2cf;
    padding-bottom: 14px;
  }
  .bio-avatar {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    object-fit: cover;
    border: 2.5px solid var(--golden);
  }
  .bio-verified-text {
    font-size: 10px;
    font-weight: 800;
    color: #0f8a5f;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .bio-head h3 { margin: 2px 0; font-size: 20px; color: var(--maroon); }
  .bio-head p { margin: 0; font-size: 13px; color: #666; }
  .bio-desc { font-size: 13px; color: #444; margin-bottom: 14px; }
  .bio-desc strong { color: var(--maroon); }
  .bio-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    background: var(--golden-soft);
    padding: 14px;
    border-radius: 10px;
    font-size: 13px;
    margin-bottom: 18px;
    border: 1px solid var(--golden-border);
  }
  .bio-stats span { color: #777; font-size: 12px; }
  .bio-stats strong { color: #222; }
  .btn-interest.full { width: 100%; padding: 12px; }

  /* 11. FOOTER */
  .matrimony-footer {
    background: #ffffff;
    border-top: 2px solid var(--golden-border);
    padding: 50px 20px 25px;
  }
  .footer-top {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    padding-bottom: 30px;
    border-bottom: 1px solid #eee;
  }
  .footer-brand { max-width: 380px; }
  .footer-brand .brand-title { font-size: 24px; font-weight: 900; color: var(--maroon); }
  .footer-brand p { font-size: 13px; color: #666; margin-top: 8px; line-height: 1.6; }
  .footer-links-group h4 { margin: 0 0 12px; font-size: 14px; color: var(--maroon); }
  .footer-links-group span { display: block; font-size: 13px; color: #555; margin-bottom: 6px; cursor: pointer; }
  .footer-links-group span:hover { color: var(--golden); }
  .footer-bottom {
    text-align: center;
    font-size: 12px;
    color: #888;
    margin-top: 25px;
  }

  /* KEYFRAME ANIMATIONS */
  @keyframes floatSlow {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-7px); }
  }
  @keyframes bounceSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
  @keyframes shineGlow {
    0% { background-position: 0% center; }
    100% { background-position: 200% center; }
  }
  @keyframes popIn {
    0% { transform: scale(0.9); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* RESPONSIVE DESIGN */
  @media(max-width: 900px) {
    .hero-container {
      flex-direction: column;
      gap: 30px;
    }
    .hero-right {
      width: 100%;
      justify-content: center;
    }
    .matrimony-form-card { max-width: 100%; }
    .hero-heading { font-size: 34px; }
    .nav-search { display: none; }
  }
`;