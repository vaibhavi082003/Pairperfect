export default function Home() {
    const { user, logout, saveAuth } = useAuth();
    const navigate = useNavigate();

    const [myProfile, setMyProfile] = useState(null);
    const [profiles, setProfiles] = useState(ALL_DUMMY_PROFILES);

    // Search & Category Filters
    const [search, setSearch] = useState("");
    const [genderFilter, setGenderFilter] = useState("All");
    const [religionFilter, setReligionFilter] = useState("All");

    // Login Modal State
    const [showLoginModal, setShowLoginModal] = useState(false);
    const [loginForm, setLoginForm] = useState({ email: "", password: "" });
    const [loginError, setLoginError] = useState("");
    const [loggingIn, setLoggingIn] = useState(false);

    // Selected Profile for Bio-Data Modal
    const [selectedProfile, setSelectedProfile] = useState(null);
    const [connectedIds, setConnectedIds] = useState([]);

    // Quick Hero Register State (Visual only, redirects to register)
    const [heroProfileFor, setHeroProfileFor] = useState("Myself");

    // Logged-in user ki profile fetch karo
    useEffect(() => {
        if (user) {
            api
                .get("/profile/me")
                .then((res) => setMyProfile(res.data))
                .catch(() => { });
        } else {
            setMyProfile(null);
        }
    }, [user]);

    // Login Modal Handler
    const handleLoginSubmit = async (e) => {
        e.preventDefault();
        setLoginError("");
        setLoggingIn(true);
        try {
            const { data } = await api.post("/auth/login", loginForm);
            saveAuth(data);
            setShowLoginModal(false);
            setLoginForm({ email: "", password: "" });
            if (!data.user.profileCreated) {
                navigate("/create-profile");
            }
        } catch (err) {
            setLoginError(err.response?.data?.message || "Invalid email or password");
        } finally {
            setLoggingIn(false);
        }
    };

    const calculateAge = (dob) => {
        if (!dob) return 24;
        return new Date().getFullYear() - new Date(dob).getFullYear();
    };

    const isNewUser = (createdAt) => {
        if (!createdAt) return false;
        const createdDate = new Date(createdAt);
        const today = new Date();
        const diffDays = (today - createdDate) / (1000 * 60 * 60 * 24);
        return diffDays <= 7;
    };

    // 🔥 GENDER LOGIC:
    const myGender = myProfile?.gender?.toLowerCase() || "";
    const targetGender = myGender === "male" ? "female" : myGender === "female" ? "male" : null;

    const filteredMatches = profiles.filter((p) => {
        if (myProfile?._id && p._id === myProfile._id) return false;

        if (user && targetGender) {
            if (p.gender?.toLowerCase() !== targetGender) return false;
        } else {
            if (genderFilter !== "All" && p.gender !== genderFilter) return false;
        }

        const matchesSearch =
            search === "" ||
            p.fullName?.toLowerCase().includes(search.toLowerCase()) ||
            p.city?.toLowerCase().includes(search.toLowerCase()) ||
            p.occupation?.toLowerCase().includes(search.toLowerCase());

        const matchesReligion = religionFilter === "All" || p.religion === religionFilter;

        return matchesSearch && matchesReligion;
    });

    const toggleConnect = (id) => {
        if (!user) {
            setShowLoginModal(true);
            return;
        }
        setConnectedIds((prev) =>
            prev.includes(id) ? prev.filter((item) => item !== id) : [...prev, id]
        );
    };

    return (
        <>
            <style>{homeStyles}</style>
            <div className="home-layout">

                {/* ================= 1. TRADITIONAL TOP LANGUAGE/COMMUNITY STRIP ================= */}
                <div className="top-community-bar">
                    <div className="community-list">
                        <span>Hindi</span> • <span>Punjabi</span> • <span>Bengali</span> • <span>Gujarati</span> • 
                        <span>Marathi</span> • <span>Marwadi</span> • <span>Kannada</span> • <span>Tamil</span> • 
                        <span>Telugu</span> • <span>Malayalam</span> • <span>Sindhi</span> • <span>Oriya</span>
                    </div>
                </div>

                {/* ================= 2. NAVBAR (Maroon & Golden Accents) ================= */}
                <header className="navbar">
                    <div className="nav-container">
                        <Link to="/" className="brand-logo">
                            <span className="logo-symbol">💍</span> Pair<span className="golden-text">Perfect</span>
                            <small className="logo-sub">Pavitra Rishtey</small>
                        </Link>

                        <div className="nav-search">
                            <span className="search-icon">🔍</span>
                            <input
                                type="text"
                                placeholder="Search by name, city, profession..."
                                value={search}
                                onChange={(e) => setSearch(e.target.value)}
                            />
                        </div>

                        <div className="nav-actions">
                            {user ? (
                                <>
                                    <Link to="/dashboard" className="nav-user-badge">
                                        ✨ Namaste, {user.name}
                                    </Link>
                                    <button onClick={logout} className="btn-logout">
                                        Logout
                                    </button>
                                </>
                            ) : (
                                <>
                                    <span className="member-label">Already a member?</span>
                                    <button onClick={() => setShowLoginModal(true)} className="btn-nav-login">
                                        LOGIN
                                    </button>
                                    <Link to="/register" className="btn-nav-register">
                                        Register Free
                                    </Link>
                                </>
                            )}
                        </div>
                    </div>
                </header>

                {/* ================= 3. BHARATMATRIMONY STYLE HERO SECTION ================= */}
                <section className="hero-section">
                    <div className="hero-container">
                        
                        {/* Left Side: Trust & Celebratory Banner */}
                        <div className="hero-left">
                            <div className="trust-badge-pill">
                                👑 India's Most Trusted & Premium Matrimony
                            </div>
                            <h1 className="hero-heading">
                                The <span className="highlight-maroon">Biggest & Most Trusted</span> Matrimony Service for Indians!
                            </h1>
                            <p className="hero-subtext">
                                Celebrate life together with verified brides and grooms from cultured and respected families across India.
                            </p>
                            
                            <div className="hero-stats-row">
                                <div className="stat-item">
                                    <span className="stat-number">10 Lakh+</span>
                                    <span className="stat-label">Verified Profiles</span>
                                </div>
                                <div className="stat-divider"></div>
                                <div className="stat-item">
                                    <span className="stat-number">100%</span>
                                    <span className="stat-label">Privacy Protected</span>
                                </div>
                                <div className="stat-divider"></div>
                                <div className="stat-item">
                                    <span className="stat-number">25+</span>
                                    <span className="stat-label">Years of Matchmaking</span>
                                </div>
                            </div>
                        </div>

                        {/* Right Side: Matrimony Lead / Action Card (Like Image) */}
                        <div className="hero-right">
                            <div className="matrimony-form-card">
                                <div className="form-card-header">
                                    <h3>Create a Matrimony Profile</h3>
                                    <p>Find your soulmate today</p>
                                </div>

                                <div className="form-card-body">
                                    <div className="card-input-group">
                                        <label>Profile Created For</label>
                                        <select 
                                            value={heroProfileFor} 
                                            onChange={(e) => setHeroProfileFor(e.target.value)}
                                            className="matrimony-select"
                                        >
                                            <option value="Myself">Myself</option>
                                            <option value="Son">My Son</option>
                                            <option value="Daughter">My Daughter</option>
                                            <option value="Brother">My Brother</option>
                                            <option value="Sister">My Sister</option>
                                            <option value="Friend">Relative / Friend</option>
                                        </select>
                                    </div>

                                    <div className="card-input-group">
                                        <label>Looking For</label>
                                        <select 
                                            value={genderFilter} 
                                            onChange={(e) => setGenderFilter(e.target.value)}
                                            className="matrimony-select"
                                        >
                                            <option value="All">Bride or Groom (All)</option>
                                            <option value="Female">Bride (Female)</option>
                                            <option value="Male">Groom (Male)</option>
                                        </select>
                                    </div>

                                    <div className="card-input-group">
                                        <label>Community / Religion</label>
                                        <select 
                                            value={religionFilter} 
                                            onChange={(e) => setReligionFilter(e.target.value)}
                                            className="matrimony-select"
                                        >
                                            <option value="All">All Religions</option>
                                            <option value="Hindu">Hindu</option>
                                            <option value="Sikh">Sikh</option>
                                            <option value="Muslim">Muslim</option>
                                            <option value="Christian">Christian</option>
                                        </select>
                                    </div>

                                    <button 
                                        onClick={() => {
                                            if (user) {
                                                navigate("/dashboard");
                                            } else {
                                                navigate("/register");
                                            }
                                        }} 
                                        className="btn-register-cta"
                                    >
                                        GET STARTED FREE ➔
                                    </button>

                                    <p className="card-disclaimer">
                                        *By registering, you agree to our <u>Terms</u> and <u>Privacy Policy</u>
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                </section>

                {/* ================= 4. FILTER CONTROLS STRIP ================= */}
                <section className="filter-controls-section">
                    <div className="filters-strip">
                        <span className="filter-title">⚡ Refine Profiles:</span>

                        {!user && (
                            <div className="filter-pill">
                                <label>Gender:</label>
                                <select value={genderFilter} onChange={(e) => setGenderFilter(e.target.value)}>
                                    <option value="All">All Profiles</option>
                                    <option value="Female">Brides</option>
                                    <option value="Male">Grooms</option>
                                </select>
                            </div>
                        )}

                        <div className="filter-pill">
                            <label>Religion:</label>
                            <select value={religionFilter} onChange={(e) => setReligionFilter(e.target.value)}>
                                <option value="All">All Religions</option>
                                <option value="Hindu">Hindu</option>
                                <option value="Sikh">Sikh</option>
                                <option value="Muslim">Muslim</option>
                                <option value="Christian">Christian</option>
                            </select>
                        </div>

                        {(search || religionFilter !== "All" || genderFilter !== "All") && (
                            <button
                                className="btn-reset"
                                onClick={() => {
                                    setSearch("");
                                    setGenderFilter("All");
                                    setReligionFilter("All");
                                }}
                            >
                                ✕ Clear Filters
                            </button>
                        )}
                    </div>
                </section>

                {/* ================= 5. PROFILES GRID ================= */}
                <main className="matches-wrapper">
                    <div className="matches-top">
                        <div className="section-title-box">
                            <h2 className="section-heading">Featured Verified Profiles</h2>
                            <p className="section-subheading">Handpicked and verified prospects ready for marriage</p>
                        </div>
                        <span className="status-tag">
                            {user ? `Showing: ${targetGender?.toUpperCase()}` : `Showing: ${filteredMatches.length} Profiles`}
                        </span>
                    </div>

                    {filteredMatches.length === 0 ? (
                        <div className="empty-state">
                            <span className="empty-icon">🕊️</span>
                            <h3>No Matching Profiles Found</h3>
                            <p>Try resetting the religion or search filters to explore more matches.</p>
                        </div>
                    ) : (
                        <div className="profiles-grid">
                            {filteredMatches.map((item) => {
                                const isConnected = connectedIds.includes(item._id);
                                return (
                                    <div key={item._id} className="profile-card">
                                        <div className="card-img-box">
                                            <img src={item.photoUrl} alt={item.fullName} loading="lazy" />

                                            {isNewUser(item.createdAt) && (
                                                <span className="badge-just-joined">✨ NEW</span>
                                            )}

                                            <span className={`gender-tag ${item.gender.toLowerCase()}`}>
                                                {item.gender === "Female" ? "Bride" : "Groom"}
                                            </span>
                                            <div className="verified-corner-badge">✓ Verified</div>
                                        </div>

                                        <div className="card-details">
                                            <div className="name-row">
                                                <h4>{item.fullName}</h4>
                                                <span className="age-pill">{calculateAge(item.dob)} Yrs</span>
                                            </div>

                                            <p className="vitals">
                                                {item.height} cm • {item.religion} ({item.caste})
                                            </p>

                                            <div className="meta-lines">
                                                <div><span className="meta-icon">🎓</span> {item.education}</div>
                                                <div><span className="meta-icon">💼</span> {item.occupation} • <strong>{item.annualIncome}</strong></div>
                                                <div><span className="meta-icon">📍</span> {item.city}, {item.state}</div>
                                            </div>

                                            <div className="card-btns">
                                                <button
                                                    className={`btn-interest ${isConnected ? "sent" : ""}`}
                                                    onClick={() => toggleConnect(item._id)}
                                                >
                                                    {isConnected ? "✓ Request Sent" : "Connect Now"}
                                                </button>
                                                <button
                                                    className="btn-bio"
                                                    onClick={() => setSelectedProfile(item)}
                                                >
                                                    View Bio
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    )}
                </main>

                {/* ================= 6. LOGIN POPUP MODAL ================= */}
                {showLoginModal && (
                    <div className="modal-backdrop" onClick={() => setShowLoginModal(false)}>
                        <div className="login-modal-box" onClick={(e) => e.stopPropagation()}>
                            <button className="close-btn" onClick={() => setShowLoginModal(false)}>✕</button>

                            <div className="modal-title">
                                <span className="modal-icon">🌸</span>
                                <h2>Welcome Back</h2>
                                <p>Sign in to your PairPerfect Matrimony Account</p>
                            </div>

                            {loginError && <div className="modal-error">{loginError}</div>}

                            <form onSubmit={handleLoginSubmit} className="modal-form">
                                <div className="input-box">
                                    <label>Registered Email</label>
                                    <input
                                        type="email"
                                        placeholder="yourname@gmail.com"
                                        value={loginForm.email}
                                        onChange={(e) => setLoginForm({ ...loginForm, email: e.target.value })}
                                        required
                                    />
                                </div>

                                <div className="input-box">
                                    <label>Password</label>
                                    <input
                                        type="password"
                                        placeholder="••••••••"
                                        value={loginForm.password}
                                        onChange={(e) => setLoginForm({ ...loginForm, password: e.target.value })}
                                        required
                                    />
                                </div>

                                <button type="submit" className="btn-modal-submit" disabled={loggingIn}>
                                    {loggingIn ? "Logging in..." : "LOG IN"}
                                </button>
                            </form>

                            <p className="modal-bottom">
                                New to PairPerfect?{" "}
                                <Link to="/register" onClick={() => setShowLoginModal(false)}>
                                    Register Free Today
                                </Link>
                            </p>
                        </div>
                    </div>
                )}

                {/* ================= 7. BIO-DATA DETAILS MODAL ================= */}
                {selectedProfile && (
                    <div className="modal-backdrop" onClick={() => setSelectedProfile(null)}>
                        <div className="bio-modal-box" onClick={(e) => e.stopPropagation()}>
                            <button className="close-btn" onClick={() => setSelectedProfile(null)}>✕</button>

                            <div className="bio-head">
                                <img src={selectedProfile.photoUrl} alt="" className="bio-avatar" />
                                <div>
                                    <div className="bio-verified-text">✓ 100% Verified Profile</div>
                                    <h3>{selectedProfile.fullName}</h3>
                                    <p>{calculateAge(selectedProfile.dob)} Years • {selectedProfile.occupation} • {selectedProfile.city}</p>
                                </div>
                            </div>

                            <div className="bio-body">
                                <div className="bio-desc">
                                    <strong>About Candidate:</strong>
                                    <p>{selectedProfile.about || "Traditional, well-cultured and looking for a compatible life companion."}</p>
                                </div>

                                <div className="bio-stats">
                                    <div><span>Community:</span> <strong>{selectedProfile.religion} ({selectedProfile.caste})</strong></div>
                                    <div><span>Diet Preference:</span> <strong>{selectedProfile.diet}</strong></div>
                                    <div><span>Marital Status:</span> <strong>{selectedProfile.maritalStatus}</strong></div>
                                    <div><span>Annual Package:</span> <strong>{selectedProfile.annualIncome}</strong></div>
                                    <div><span>Education:</span> <strong>{selectedProfile.education}</strong></div>
                                    <div><span>Current City:</span> <strong>{selectedProfile.city}, {selectedProfile.state}</strong></div>
                                </div>
                            </div>

                            <button
                                className={`btn-interest full ${connectedIds.includes(selectedProfile._id) ? "sent" : ""}`}
                                onClick={() => toggleConnect(selectedProfile._id)}
                            >
                                {connectedIds.includes(selectedProfile._id) ? "✓ Request Sent Successfully" : "Send Express Interest 💌"}
                            </button>
                        </div>
                    </div>
                )}

                {/* Footer Strip */}
                <footer className="matrimony-footer">
                    <p>© PairPerfect Matrimony — India's Premier Matchmaking Portal. All Rights Reserved.</p>
                </footer>

            </div>
        </>
    );
}

