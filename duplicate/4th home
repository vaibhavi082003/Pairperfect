                                    <input
                                        type="password"
                                        placeholder="••••••••"
                                        value={loginForm.password}
                                        onChange={(e) => setLoginForm({ ...loginForm, password: e.target.value })}
                                        required
                                    />
                                </div>

                                <button type="submit" className="btn-modal-submit" disabled={loggingIn}>
                                    {loggingIn ? "Logging in..." : "Log in"}
                                </button>
                            </form>

                            <p className="modal-bottom">
                                New to PairPerfect?{" "}
                                <Link to="/register" onClick={() => setShowLoginModal(false)}>
                                    Register free today
                                </Link>
                            </p>
                        </div>
                    </div>
                )}

                {/* ================= 7. BIO-DATA MODAL ================= */}
                {selectedProfile && (
                    <div className="modal-backdrop" onClick={() => setSelectedProfile(null)}>
                        <div
                            className="sheet bio-modal-box"
                            role="dialog"
                            aria-modal="true"
                            aria-label={`${selectedProfile.fullName} bio-data`}
                            onClick={(e) => e.stopPropagation()}
                        >
                            <button className="close-btn" aria-label="Close" onClick={() => setSelectedProfile(null)}>✕</button>

                            <div className="bio-head">
                                <div className="bio-avatar-wrap">
                                    <Photo src={selectedProfile.photoUrl} name={selectedProfile.fullName} />
                                </div>
                                <div>
                                    <div className="bio-verified-text">✓ 100% verified profile</div>
                                    <h3>{selectedProfile.fullName}</h3>
                                    <p>{calculateAge(selectedProfile.dob)} years, {selectedProfile.occupation}, {selectedProfile.city}</p>
                                </div>
                            </div>

                            <div className="bio-body">
                                <div className="bio-desc">
                                    <strong>About</strong>
                                    <p>{selectedProfile.about || "Traditional, well-cultured and looking for a compatible life companion."}</p>
                                </div>

                                <div className="bio-stats">
                                    <div><span>Community</span><strong>{selectedProfile.religion} ({selectedProfile.caste})</strong></div>
                                    <div><span>Diet</span><strong>{selectedProfile.diet}</strong></div>
                                    <div><span>Marital status</span><strong>{selectedProfile.maritalStatus}</strong></div>
                                    <div><span>Annual package</span><strong>{selectedProfile.annualIncome}</strong></div>
                                    <div><span>Education</span><strong>{selectedProfile.education}</strong></div>
                                    <div><span>Current city</span><strong>{selectedProfile.city}, {selectedProfile.state}</strong></div>
                                </div>
                            </div>

                            <button
                                className={`btn-interest full ${connectedIds.includes(selectedProfile._id) ? "sent" : ""}`}
                                onClick={() => toggleConnect(selectedProfile._id)}
                            >
                                {connectedIds.includes(selectedProfile._id) ? "✓ Request sent" : "Send interest 💌"}
                            </button>
                        </div>
                    </div>
                )}

                <footer className="matrimony-footer">
                    <p>© PairPerfect Matrimony — India's Premier Matchmaking Portal. All Rights Reserved.</p>
                </footer>
            </div>
        </>
    );
}

