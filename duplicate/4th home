  .sheet {
    position: relative;
    width: 100%;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    background: var(--ivory);
    color: var(--ink);
    border: 2px solid var(--gold);
    border-radius: 50% 50% 22px 22px / 36px 36px 22px 22px;
    box-shadow: 0 0 0 5px rgba(212, 167, 44, 0.2), 0 24px 60px rgba(0, 0, 0, 0.5);
    animation: pop 0.25s ease both;
  }
  .login-modal-box { max-width: 410px; padding: 48px 26px 26px; }
  .bio-modal-box { max-width: 520px; padding: 48px 26px 26px; }
  .close-btn {
    position: absolute;
    top: 34px;
    right: 14px;
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 50%;
    background: var(--ivory-2);
    color: var(--maroon);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .close-btn:hover { background: #ecd7a6; }

  .modal-title { text-align: center; margin-bottom: 18px; }
  .modal-icon { font-size: 26px; }
  .modal-title h2 { font-family: var(--display); font-weight: 400; font-size: 26px; margin: 4px 0; color: var(--maroon); }
  .modal-title p { margin: 0; font-size: 14.5px; color: var(--ink-soft); }
  .modal-error { background: #fde8e8; border: 1px solid #f8b4b4; color: #9b1c1c; padding: 10px; border-radius: 8px; font-size: 14px; margin-bottom: 14px; text-align: center; }
  .modal-form { display: flex; flex-direction: column; gap: 14px; }
  .input-box { display: flex; flex-direction: column; gap: 5px; }
  .input-box label { font-size: 13.5px; font-weight: 600; }
  .input-box input {
    padding: 11px 12px;
    border: 1.5px solid #dcc58f;
    border-radius: 10px;
    background: #fffdf7;
    color: var(--ink);
    font-size: 15px;
    outline: none;
  }
  .input-box input:focus { border-color: var(--maroon); }
  .btn-modal-submit {
    margin-top: 4px;
    padding: 12px;
    border: 1px solid var(--gold);
    border-radius: 10px;
    background: var(--maroon);
    color: var(--ivory);
    font-size: 15.5px;
    font-weight: 700;
    cursor: pointer;
  }
  .btn-modal-submit:hover { background: var(--wine); }
  .btn-modal-submit:disabled { opacity: 0.7; cursor: wait; }
  .modal-bottom { text-align: center; font-size: 14px; color: var(--ink-soft); margin: 16px 0 0; }
  .modal-bottom a { color: var(--maroon); font-weight: 700; }

  .bio-head { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; padding-bottom: 14px; border-bottom: 1px dashed #d9c18a; }
  .bio-avatar-wrap { flex: none; width: 84px; height: 104px; border: 2px solid var(--gold); border-radius: 999px 999px 8px 8px; overflow: hidden; background: #e9d5ad; }
  .bio-avatar-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bio-avatar-wrap .photo-fallback { font-size: 30px; }
  .bio-verified-text { font-size: 13px; font-weight: 600; color: #0f7a55; }
  .bio-head h3 { font-family: var(--display); font-weight: 400; font-size: 26px; margin: 2px 0; color: var(--maroon); }
  .bio-head p { margin: 0; font-size: 14.5px; color: var(--ink-soft); }
  .bio-desc { margin-bottom: 14px; font-size: 14.5px; }
  .bio-desc strong { color: var(--maroon); }
  .bio-desc p { margin: 4px 0 0; line-height: 1.55; }
  .bio-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 16px;
    margin-bottom: 18px;
    padding: 14px;
    background: var(--ivory-2);
    border: 1px solid #e2cd9a;
    border-radius: 12px;
  }
  .bio-stats div { display: flex; flex-direction: column; }
  .bio-stats span { font-size: 13px; color: var(--ink-soft); }
  .bio-stats strong { font-size: 14.5px; }
  .btn-interest.full { width: 100%; flex: none; padding: 12px; }

  /* ---------- FOOTER ---------- */
  .matrimony-footer { background: #14010a; border-top: 1px solid var(--gold-line); padding: 24px 20px; text-align: center; font-size: 13.5px; color: rgba(255, 247, 230, 0.6); }
  .matrimony-footer p { margin: 0; }

  /* ---------- KEYFRAMES ---------- */
  @keyframes marq { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes spin { from { transform: translateY(-50%) rotate(0deg); } to { transform: translateY(-50%) rotate(360deg); } }
  @keyframes spinrev { from { transform: rotate(0deg); } to { transform: rotate(-360deg); } }
  @keyframes drift { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(120px, 80px, 0) scale(1.25); } }
  @keyframes petal {
    0% { transform: translate3d(0, -8vh, 0) rotate(0deg); opacity: 0; }
    8% { opacity: 0.9; }
    50% { transform: translate3d(46px, 48vh, 0) rotate(200deg); }
    100% { transform: translate3d(-34px, 105vh, 0) rotate(400deg); opacity: 0; }
  }
  @keyframes fillbar { from { width: 0; } to { width: 100%; } }
  @keyframes wm { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes fadein { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pop { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .hero-section { padding: 40px 16px 80px; min-height: 0; }
    .hero-container { grid-template-columns: 1fr; gap: 36px; }
    .hero-right { justify-content: center; }
    .nav-search { display: none; }
    .m-big { right: -45%; opacity: 0.18; }
  }
  @media (max-width: 560px) {
    .member-label { display: none; }
    .bio-stats { grid-template-columns: 1fr; }
    .scene-tab { min-width: 78px; padding: 10px 12px 9px; }
    .matches-top { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-layout *, .home-layout *::before, .home-layout *::after {
      animation: none !important;
      transition: none !important;
    }
    .petal { display: none; }
    .scene-tab.on .st-bar i { width: 100%; }
  }
`;