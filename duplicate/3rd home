    color: var(--velvet-maroon);
    margin: 0;
  }
  .section-subheading {
    margin: 4px 0 0;
    font-size: 13px;
    color: #666;
  }
  .status-tag {
    background: #ffffff;
    border: 1.5px solid var(--gold-liquid);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    color: var(--velvet-maroon);
    font-weight: 800;
    box-shadow: 0 2px 8px rgba(197, 155, 39, 0.12);
  }

  .profiles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 24px;
  }
  .profile-card {
    background: #ffffff;
    border: 1.5px solid var(--gold-border);
    border-radius: 18px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
  }
  .profile-card:hover {
    transform: translateY(-6px);
    border-color: var(--gold-liquid);
    box-shadow: 0 16px 32px rgba(93, 9, 30, 0.14);
  }
  .card-img-box {
    position: relative;
    height: 250px;
    background: #f0e6d6;
  }
  .card-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .badge-just-joined {
    position: absolute;
    top: 10px;
    left: 10px;
    background: linear-gradient(135deg, var(--gold-bright), #b8860b);
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 12px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
  }
  .gender-tag {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px 9px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  .gender-tag.female { color: #b8005b; }
  .gender-tag.male { color: #0f52ba; }

  .verified-corner-badge {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(16, 185, 129, 0.95);
    color: white;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .card-details { padding: 16px; }
  .name-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-details h4 {
    margin: 0;
    font-size: 17px;
    font-weight: 800;
    color: #1a1a1a;
  }
  .age-pill {
    background: #fff8ea;
    color: var(--velvet-maroon);
    font-size: 11px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 10px;
    border: 1px solid var(--gold-border);
  }
  .vitals {
    color: var(--velvet-maroon);
    font-weight: 700;
    font-size: 12.5px;
    margin: 4px 0 10px;
  }
  .meta-lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12.5px;
    color: #444;
    margin-bottom: 16px;
    background: #fffdf9;
    padding: 9px 12px;
    border-radius: 10px;
    border: 1px solid #f3e5cd;
  }
  .card-btns { display: flex; gap: 8px; }
  .btn-interest {
    flex: 1;
    background: linear-gradient(135deg, var(--velvet-maroon) 0%, var(--velvet-maroon-bright) 100%);
    color: #ffffff;
    border: none;
    padding: 10px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 800;
    font-size: 13px;
    transition: 0.2s;
  }
  .btn-interest:hover {
    background: linear-gradient(135deg, var(--velvet-maroon-dark) 0%, var(--velvet-maroon) 100%);
  }
  .btn-interest.sent { background: #0f8a5f; }
  .btn-bio {
    background: #ffffff;
    border: 1.5px solid var(--gold-liquid);
    color: var(--velvet-maroon);
    padding: 10px 14px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 12.5px;
    font-weight: 800;
    transition: 0.2s;
  }
  .btn-bio:hover { background: #fff8e8; }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #fff;
    border-radius: 16px;
    border: 1px solid var(--gold-border);
  }
  .empty-icon { font-size: 40px; margin-bottom: 10px; display: inline-block; }

  /* 6. LUXURY PILLARS SECTION */
  .luxury-pillars-section {
    background: #ffffff;
    border-top: 1.5px solid var(--gold-border);
    border-bottom: 1.5px solid var(--gold-border);
    padding: 60px 20px;
  }
  .section-container {
    max-width: 1220px;
    margin: 0 auto;
  }
  .center-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 40px;
  }
  .center-header h2 {
    font-size: 32px;
    font-weight: 900;
    color: var(--velvet-maroon);
    margin: 8px 0;
  }
  .center-header p {
    color: #666;
    font-size: 15px;
    margin: 0;
  }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 26px;
  }
  .pillar-card {
    background: #fffdf9;
    border: 1.5px solid var(--gold-border);
    padding: 28px 24px;
    border-radius: 18px;
    transition: transform 0.25s ease, border-color 0.25s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .pillar-card:hover {
    transform: translateY(-5px);
    border-color: var(--gold-liquid);
    box-shadow: 0 12px 25px rgba(197, 155, 39, 0.15);
  }
  .pillar-icon {
    font-size: 32px;
    color: var(--gold-liquid);
    margin-bottom: 14px;
  }
  .pillar-card h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 800;
    color: var(--velvet-maroon);
  }
  .pillar-card p {
    margin: 0;
    font-size: 13.5px;
    color: #555;
    line-height: 1.6;
  }

  /* 7. STEPPING STONES SECTION */
  .stepping-stones-section {
    padding: 60px 20px;
    background: #fbf7ee;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 26px;
  }
  .step-card {
    background: #ffffff;
    border: 2px dashed var(--gold-border);
    padding: 30px 24px;
    border-radius: 18px;
    position: relative;
  }
  .step-badge {
    background: var(--velvet-maroon);
    color: var(--gold-bright);
    font-size: 11px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 12px;
    display: inline-block;
    margin-bottom: 12px;
  }
  .step-card h4 {
    margin: 0 0 8px;
    font-size: 18px;
    color: var(--velvet-maroon);
  }
  .step-card p {
    margin: 0;
    font-size: 13.5px;
    color: #666;
    line-height: 1.6;
  }

  /* 8. TESTIMONIALS SECTION */
  .testimonials-section {
    padding: 60px 20px;
    background: #ffffff;
    border-top: 1.5px solid var(--gold-border);
  }
  .stories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .story-card {
    background: #fffdf9;
    border: 1.5px solid var(--gold-border);
    padding: 24px;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .highlight-story {
    border-color: var(--gold-liquid);
    box-shadow: 0 10px 30px rgba(197, 155, 39, 0.15);
    background: #fffbf2;
  }
  .story-stars { font-size: 14px; margin-bottom: 12px; }
  .story-quote {
    font-size: 13.5px;
    line-height: 1.6;
    color: #333;
    font-style: italic;
    margin: 0 0 16px;
  }
  .story-author strong {
    display: block;
    font-size: 15px;
    color: var(--velvet-maroon);
  }
  .story-author span {
    font-size: 12px;
    color: #777;
  }

  /* 9. MODALS */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(35, 4, 11, 0.72);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 300;
    padding: 20px;
  }
  .login-modal-box {
    background: #ffffff;
    border: 2px solid var(--gold-liquid);
    border-radius: 20px;
    width: 100%;
    max-width: 400px;
    padding: 30px 24px;
    position: relative;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
  }
  .close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #f7ede2;
    border: none;
    color: var(--velvet-maroon);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 14px;
    cursor: pointer;
    font-weight: bold;
  }
  .modal-title { text-align: center; margin-bottom: 20px; }
  .modal-icon { font-size: 26px; color: var(--gold-liquid); }
  .modal-title h2 {
    margin: 4px 0 4px;
    font-size: 22px;
    color: var(--velvet-maroon);
    font-weight: 800;
  }
  .modal-title p { margin: 0; color: #666; font-size: 13px; }
  .modal-error {
    background: #fde8e8;
    border: 1px solid #f8b4b4;
    color: #9b1c1c;
    padding: 10px;
    border-radius: 8px;
    font-size: 13px;
    margin-bottom: 14px;
    text-align: center;
  }
  .modal-form { display: flex; flex-direction: column; gap: 14px; }
  .input-box { display: flex; flex-direction: column; gap: 5px; text-align: left; }
  .input-box label { font-size: 12px; color: #444; font-weight: 700; }
  .input-box input {
    background: #fffdfa;
    border: 1.5px solid var(--gold-border);
    border-radius: 8px;
    padding: 11px 12px;
    color: #222;
    font-size: 14px;
    outline: none;
  }
  .input-box input:focus { border-color: var(--velvet-maroon); }
  .btn-modal-submit {
    background: linear-gradient(135deg, var(--velvet-maroon) 0%, var(--velvet-maroon-bright) 100%);
    color: white;
    border: none;
    padding: 12px;
    border-radius: 8px;
    font-weight: 800;
    cursor: pointer;
    margin-top: 6px;
    font-size: 14px;
  }
  .modal-bottom { text-align: center; font-size: 13px; color: #666; margin: 16px 0 0; }
  .modal-bottom a { color: var(--velvet-maroon); text-decoration: underline; font-weight: 700; }

  /* Bio-Data Modal */
  .bio-modal-box {
    background: #ffffff;
    border: 2px solid var(--gold-liquid);
    border-radius: 18px;
    width: 100%;
    max-width: 500px;
    padding: 24px;
    position: relative;
    box-shadow: 0 20px 45px rgba(0,0,0,0.3);
  }
  .bio-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid #f0e2cf;
    padding-bottom: 14px;
  }
  .bio-avatar {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    object-fit: cover;
    border: 2.5px solid var(--gold-liquid);
  }
  .bio-verified-text {
    font-size: 10px;
    font-weight: 800;
    color: #0f8a5f;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .bio-head h3 { margin: 2px 0; font-size: 20px; color: var(--velvet-maroon); }
  .bio-head p { margin: 0; font-size: 13px; color: #666; }
  .bio-desc { font-size: 13px; color: #444; margin-bottom: 14px; }
  .bio-desc strong { color: var(--velvet-maroon); }
  .bio-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    background: #fff8eb;
    padding: 14px;
    border-radius: 10px;
    font-size: 13px;
    margin-bottom: 18px;
    border: 1px solid var(--gold-border);
  }
  .bio-stats span { color: #777; font-size: 12px; }
  .bio-stats strong { color: #222; }
  .btn-interest.full { width: 100%; padding: 12px; }

  /* 11. FOOTER */
  .matrimony-footer {
    background: #ffffff;
    border-top: 2px solid var(--gold-liquid);
    padding: 50px 20px 25px;
  }
  .footer-top {
    max-width: 1220px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    padding-bottom: 30px;
    border-bottom: 1px solid #eee;
  }
  .footer-brand { max-width: 380px; }
  .footer-brand .brand-title { font-size: 24px; font-weight: 900; color: var(--velvet-maroon); }
  .footer-brand p { font-size: 13px; color: #666; margin-top: 8px; line-height: 1.6; }
  .footer-links-group h4 { margin: 0 0 12px; font-size: 14px; color: var(--velvet-maroon); }
  .footer-links-group span { display: block; font-size: 13px; color: #555; margin-bottom: 6px; cursor: pointer; }
  .footer-links-group span:hover { color: var(--gold-liquid); }
  .footer-bottom {
    text-align: center;
    font-size: 12px;
    color: #888;
    margin-top: 25px;
  }

  /* KEYFRAME ANIMATIONS FOR BRIDE & GROOM CONVERGENCE */
  @keyframes groomGlide {
    0% { transform: translateX(0px) scale(0.96); }
    100% { transform: translateX(28px) scale(1.04); }
  }
  @keyframes brideGlide {
    0% { transform: translateX(0px) scale(0.96); }
    100% { transform: translateX(-28px) scale(1.04); }
  }
  @keyframes orbPulse {
    0% { transform: scale(0.92); box-shadow: 0 0 15px rgba(231, 191, 83, 0.5); }
    100% { transform: scale(1.08); box-shadow: 0 0 35px rgba(231, 191, 83, 0.95); }
  }
  @keyframes rotateSlow {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @keyframes shineSweep {
    0% { transform: translate(-100%, -100%) rotate(45deg); }
    30%, 100% { transform: translate(100%, 100%) rotate(45deg); }
  }
  @keyframes twinkleFloat {
    0%, 100% { transform: translateY(0) scale(0.8); opacity: 0.3; }
    50% { transform: translateY(-10px) scale(1.2); opacity: 0.8; }
  }

  /* RESPONSIVE DESIGN */
  @media(max-width: 992px) {
    .hero-container {
      flex-direction: column;
      gap: 36px;
    }
    .hero-form-station {
      width: 100%;
      justify-content: center;
    }
    .glossy-royal-card { max-width: 100%; }
    .hero-royal-headline { font-size: 32px; }
    .nav-search { display: none; }
    .convergence-stage-box { max-width: 100%; }
  }
`;