                      <Photo
                        src={form.photoUrl}
                        name={form.fullName || "Your Name"}
                      />
                    </div>
                  </div>

                  <span className="badge-new">New</span>

                  <span className={`role-tag ${form.gender?.toLowerCase() === "male" ? "male" : "female"}`}>
